# Pinned versions of everything that goes into a build.
# Every file referenced here must also have an entry (with sha256) in
# config/sources.lock. Use scripts/update-llvm.sh to bump LLVM.

LLVM_VERSION=23.1.6

# Used to normalise timestamps in the output tarball.
# Set to the publication time of the LLVM release (2026-11-17T16:32:45Z).
SOURCE_DATE_EPOCH=1794933165

# Build tools installed into the builder image.
CMAKE_VERSION=4.5.1
NINJA_VERSION=1.13.2
ZSTD_VERSION=1.5.7
PYTHON_VERSION=3.12.16
